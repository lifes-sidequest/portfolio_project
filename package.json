{
  "name": "aziz-baratov-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .next-build --ignore-pattern .next-turbo --ignore-pattern test-results --ignore-pattern playwright-report",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "perf:audit": "lhci autorun",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
